<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set fullTitle = (title + " | " + site.name) if title else site.name %}
<title>{{ fullTitle }}</title>
<meta name="description" content="{{ description or site.seo_description }}">
<meta property="og:title" content="{{ fullTitle }}">
<meta property="og:description" content="{{ description or site.seo_description }}">
<meta property="og:type" content="website">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{{ site.name }}</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="nav" id="site-nav" aria-label="Main">
      <a href="/services/"{% if current == "services" %} aria-current="page"{% endif %}>Services</a>
      <a href="/work/"{% if current == "work" %} aria-current="page"{% endif %}>Work</a>
      <a href="/about/"{% if current == "about" %} aria-current="page"{% endif %}>About</a>
      <a class="btn btn--primary" href="/contact/">{{ site.nav_button }}</a>
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap">
    <div>
      <a class="brand" href="/">{{ site.name }}</a>
      <p>{{ site.footer_line }}</p>
    </div>
    <nav aria-label="Footer">
      <a href="/services/">Services</a>
      <a href="/work/">Work</a>
      <a href="/about/">About</a>
      <a href="{{ site.linkedin_url }}">LinkedIn</a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </nav>
  </div>
</footer>
<script src="/main.js"></script>
</body>
</html>
